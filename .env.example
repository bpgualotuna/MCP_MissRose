# Configuración del Proyecto Mr. Rose MCP
# Copia este archivo como .env y coloca tus valores reales

# API Key de Google AI Studio (obtén una gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Configuración del Modelo de Visión
MODEL_WEIGHTS_PATH=models/rose_disease_model.onnx
DEVICE=cuda  # 'cuda' o 'cpu'
CONFIDENCE_THRESHOLD=0.80

# Servidor MCP y Web API
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
